# ─────────────────────────────────────────────────────────────
# PerpEx — Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Google OAuth (configured in Supabase Dashboard) ───────────
# Set Client ID and Secret in: Supabase Dashboard → Auth → Providers → Google
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is stored only in Supabase, never here

# ── Analytics (optional) ─────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# ── Error Tracking (optional — Sentry) ───────────────────────
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
